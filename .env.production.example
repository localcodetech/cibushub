# Copy to .env.production on the VPS (never commit it). Used by compose.prod.yaml.
# The server's own secrets go in server/.env.production and server/.env.demo.

# ─── Addresses. Cloudflare DNS: an A record for each, pointing at the VPS, "DNS only" ───
# The real site (www.<APP_DOMAIN> redirects to it)
APP_DOMAIN=cibushubgh.com
# The real API's own address: live Paystack and Resend webhooks
API_DOMAIN=api.cibushubgh.com
# The demo site
DEMO_DOMAIN=demo.cibushubgh.com
# Let's Encrypt contacts this address if a certificate can't renew
ACME_EMAIL=you@example.com

# ─── Public values baked into the app (anyone can read them in the browser) ───
# Google: add BOTH https://cibushubgh.com and https://demo.cibushubgh.com as authorised
# JavaScript origins in the Google Cloud console
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_SERVICE_ID=
# Facebook: the App ID (Meta for Developers → App settings → Basic)
VITE_FACEBOOK_APP_ID=
