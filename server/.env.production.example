# Copy to server/.env.production on the VPS (never commit it). Every value here is secret.
# Make each secret new for production: don't reuse the development ones.
#   openssl rand -hex 32     (for OTP_SECRET, JWT_ACCESS_SECRET and the passwords)

PORT=5000
NODE_ENV=production
# The app's address: links in emails and SMS, Paystack's return page, allowed origin
CLIENT_URL=https://cibushubgh.com
# One proxy (Caddy) in front of the api: Express then sees each visitor's real IP, so rate
# limits and audit logs work per person. Keep Cloudflare on "DNS only" for this to be right.
TRUST_PROXY=1

# ─── Database (the mysql container creates this user and database on its first start) ───
DB_HOST=mysql
MYSQL_DATABASE=cibushub
MYSQL_USER=cibushub
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_URL=redis://redis:6379

OTP_SECRET=
JWT_ACCESS_SECRET=

# ─── The first super admin (created once with the super-admin seeder) ───
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=+233
SUPER_ADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# sk_test_... until the business is verified, then sk_live_...
# Paystack dashboard → Settings → API Keys & Webhooks → Webhook URL:
#   https://api.cibushubgh.com/api/v1/webhooks/paystack
PAYSTACK_SECRET_KEY=

NALO_API_KEY=
NALO_SENDER_ID=CibusHub

RESEND_API_KEY=
EMAIL_FROM=CibusHub <noreply@mail.cibushubgh.com>
# Resend → Webhooks → https://api.cibushubgh.com/api/v1/webhooks/resend (email.bounced)
RESEND_WEBHOOK_SECRET=
EMAIL_REPLY_TO=

GOOGLE_CLIENT_ID=
APPLE_SERVICE_ID=
# Facebook: App ID and App secret (App settings → Basic). The secret stays on the server
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT_EMAIL=
