# Copy to server/.env.demo on the VPS (never commit it): ONLY what the demo does differently.
#
# The demo reads server/.env.production first and this file on top of it (compose.prod.yaml).
# So it has everything the real site has: real SMS (Nalo), real email (Resend), photos
# (Cloudinary), Google and Apple sign-in, maps. Don't copy those here; they come automatically.
#
# It uses the same MySQL and Redis containers, but its own database and Redis database, so
# its orders, jobs and caches never touch the real site's.

CLIENT_URL=https://demo.cibushubgh.com
MYSQL_DATABASE=cibushub_demo
REDIS_URL=redis://redis:6379/1
# Lets the demo data seeders run here (never on the real site)
DEMO_SITE=true

# Paystack TEST keys: the full payment screens work, but nobody pays real money.
# Paystack dashboard (Test mode) → Webhook URL: https://demo.cibushubgh.com/api/v1/webhooks/paystack
PAYSTACK_SECRET_KEY=sk_test_

# New secrets, so a demo login can never work on the real site (openssl rand -hex 32)
OTP_SECRET=
JWT_ACCESS_SECRET=

# The demo's own super admin
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=+233
SUPER_ADMIN_PASSWORD=
