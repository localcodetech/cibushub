# Copy to server/.env.demo on the VPS (never commit it): the demo site's settings.
# Start from a copy of server/.env.production, then change ONLY what's below.
#   cp server/.env.production server/.env.demo
#
# The demo uses the same MySQL and Redis containers, but its own database and Redis
# database, so its orders, jobs and caches never touch the real site's.

CLIENT_URL=https://demo.cibushubgh.com
MYSQL_DATABASE=cibushub_demo
REDIS_URL=redis://redis:6379/1
# Lets the demo data seeders run here (never on the real site)
DEMO_SITE=true

# Paystack TEST keys only: nobody pays real money on the demo.
# Paystack dashboard (Test mode) → Webhook URL: https://demo.cibushubgh.com/api/v1/webhooks/paystack
PAYSTACK_SECRET_KEY=sk_test_

# New secrets, so a demo login can never work on the real site
OTP_SECRET=
JWT_ACCESS_SECRET=

# The demo's own super admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=+233
SUPER_ADMIN_PASSWORD=

# Real SMS and email are sent from the demo too (decided 2026-10-10), so the same
# NALO_* and RESEND_* values as production are fine.
