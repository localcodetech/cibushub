PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173



MYSQL_DATABASE=cibushub
MYSQL_USER=cibushub
MYSQL_PASSWORD=choose-a-password
MYSQL_ROOT_PASSWORD=root-password
DB_HOST=mysql
REDIS_URL=redis://redis:6379



SUPER_ADMIN_NAME=Your Name
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PHONE=+233XXXXXXXXX
SUPER_ADMIN_PASSWORD=choose-a-strong-password
OTP_SECRET=generate-with-openssl-rand-hex-32

JWT_ACCESS_SECRET=<paste the value here>

TRUST_PROXY=0


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=



PAYSTACK_SECRET_KEY=



NALO_SENDER_ID=
NALO_API_KEY=

# Email through Resend (resend.com). Without a key, emails are only printed (development).
# EMAIL_FROM must use the domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=CibusHub <noreply@mail.cibushubgh.com>
# Resend → Webhooks → add https://<api domain>/api/v1/webhooks/resend with the
# "email.bounced" event, then paste its signing secret (whsec_...) here
RESEND_WEBHOOK_SECRET=
EMAIL_REPLY_TO=


GOOGLE_CLIENT_ID=
APPLE_SERVICE_ID=
# Facebook: App ID and App secret (App settings → Basic). The secret stays on the server
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=


# Maps lookups through OpenStreetMap Nominatim (free, no key). Put a real contact email here.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT_EMAIL=
